<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C4156"
    tools:context=".PerfilActivity">

    <!-- Avatar de Usuario circular -->
    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nombre de usuario -->
    <TextView
        android:id="@+id/txtPerfilNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="David Marlon Malagon"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnEditarNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar"
        android:textColor="#D1D5DB"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtPerfilNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Formulario de Campos -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnEditarNombre"
        app:layout_constraintBottom_toTopOf="@id/bottomNavPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Oficio -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OFICIO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Correo Electrónico -->
            <EditText
                android:id="@+id/edtPerfilCorreo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Correo Electrónico"
                android:paddingHorizontal="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Contraseña -->
            <EditText
                android:id="@+id/edtPerfilPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Teléfono de contacto -->
            <EditText
                android:id="@+id/edtPerfilTelefono"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Teléfono de contacto"
                android:inputType="phone"
                android:paddingHorizontal="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Alcaldía de Trabajo -->
            <EditText
                android:id="@+id/edtPerfilAlcaldia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Alcaldía de Trabajo"
                android:paddingHorizontal="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- Botón Guardar Cambios -->
            <Button
                android:id="@+id/btnGuardarCambios"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Guardar Cambios"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1B365D" />

        </LinearLayout>
    </ScrollView>

    <!-- Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavPerfil"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1B365D"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:menu="@menu/bottom_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
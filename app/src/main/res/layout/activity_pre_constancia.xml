<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <!-- ENCABEZADO SUPERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeTopBar"
        layout="@layout/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DATOS DE USUARIO Y TÍTULO DE SECCIÓN -->
    <LinearLayout
        android:id="@+id/layoutUserTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/includeTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="David Marlon Malagon Fuentes"
            android:textColor="?attr/appTextColor"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/txtSectionSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pre-Constancia"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- TARJETA BLANCA TIPO DOCUMENTO -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDocument"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/appCardColor"
        app:layout_constraintTop_toBottomOf="@id/layoutUserTitle"
        app:layout_constraintBottom_toTopOf="@id/btnDownload"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@android:color/white">

                <!-- ENCABEZADO INTERNO: TÍTULO Y LOGO AZUL A LA DERECHA -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Pre-Constancia"
                        android:textColor="#1D3E5B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <!-- LOGO ACREDITATECH AZUL Y TEXTO AZUL -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Logo Azul"
                            android:src="@drawable/logoazul" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="serif"
                            android:text="AcreditaTech"
                            android:textColor="#1D3E5B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- AVATAR CON CÍRCULO GRIS VISIBLE Y DATOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <!-- CIRCULITO GRIS DEL AVATAR -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="#E0E0E0"
                        android:src="@drawable/perfil"
                        app:tint="#253A49"
                        android:padding="12dp"
                        android:contentDescription="Avatar Documento" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Se le otorga a:"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/txtRecipientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="David Gael Malagon Fuentes"
                            android:textColor="@android:color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TEXTO -->
                <TextView
                    android:id="@+id/txtConstanciaLine1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--------------------------------------------------"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtConstanciaLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--------------------------------------------------"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtConstanciaLine3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--------------------------------------------------"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtConstanciaLine4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--------------------------------------------------"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtConstanciaLine5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--------------------------------------------------"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtConstanciaLine6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--------------------------------------------------"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:gravity="center" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- BOTÓN DESCARGAR PRE-CONSTANCIA -->
    <Button
        android:id="@+id/btnDownload"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1D3E5B"
        android:text="Descargar Pre-Constancia"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BARRA INFERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
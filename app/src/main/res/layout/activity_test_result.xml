<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <!-- ENCABEZADO SUPERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeTopBar"
        layout="@layout/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BARRA INFERIOR REUTILIZABLE (Anclada al fondo para que sea fija) -->
    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTENEDOR CON SCROLL GENERAL PARA QUE AL GIRAR PANTALLA NO SE SOLAPE -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/includeTopBar"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- DATOS DE USUARIO Y TÍTULO DE LA CALIFICACIÓN -->
            <LinearLayout
                android:id="@+id/layoutUserTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="David Marlon Malagon Fuentes"
                    android:textColor="?attr/appTextColor"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/txtTestTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calificación de Test Técnico"
                    android:textColor="#78909C"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- TARJETA CENTRAL DE RESULTADOS (Mantiene sus dimensiones originales con wrap_content) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="?attr/appCardColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calificación:"
                        android:textColor="?attr/appTextColor"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Llevas un avance total del:"
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <!-- CAJA DE PORCENTAJE -->
                    <LinearLayout
                        android:id="@+id/layoutScoreBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_score_green"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/txtPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@android:color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:id="@+id/txtAcerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aciertos: 10 de 10 preguntas correctas."
                            android:textColor="@android:color/black"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- MENSAJES DE RETROALIMENTACIÓN -->
                    <TextView
                        android:id="@+id/txtFeedbackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Ya lo tienes!"
                        android:textColor="?attr/appTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/txtFeedbackMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Muy bien, lo has conseguido, has demostrado ser una persona apta."
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:gravity="center" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <!-- ENCABEZADO SUPERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeTopBar"
        layout="@layout/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTENEDOR PRINCIPAL DEL PANEL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/includeTopBar"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Título: Panel de usuario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_panel_title"
                android:textColor="?attr/appTextColor"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_panel_subtitle"
                android:textColor="#78909C"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- TARJETA 1: Test Técnico -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/appCardColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_tecnico_title"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_visualize_desc"
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnVisualizarTecnico"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_visualizar"
                        android:textColor="@android:color/white"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="@color/btn_general"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARJETA 2: Test Ocupacional -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/appCardColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_ocupacional_title"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_visualize_desc"
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnVisualizarOcupacional"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_visualizar"
                        android:textColor="@android:color/white"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="@color/btn_general"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARJETA 3: Guías -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/appCardColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_final"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_visualize_desc"
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnVisualizarFinal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_visualizar"
                        android:textColor="@android:color/white"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="@color/btn_general"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BARRA DE NAVEGACIÓN INFERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
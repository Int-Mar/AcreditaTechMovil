<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una guía (la usa GuiaAdapter dentro del RecyclerView de activity_detalleguia) -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/appCardColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado de la tarjeta: número de guía y tema -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#386B90"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/txtGuiaNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DDE7EF"
                android:textSize="12sp"
                tools:text="Guía 1 de 5 · E-T1" />

            <TextView
                android:id="@+id/txtGuiaTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="@string/titulo_guia" />
        </LinearLayout>

        <!-- Cuerpo de la tarjeta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtGuiaTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#1D3E5B"
                android:textSize="15sp"
                android:textStyle="italic"
                tools:text="Conceptos básicos de seguridad" />

            <TextView
                android:id="@+id/txtGuiaContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#333333"
                android:textSize="14sp"
                tools:text="Texto de la guía…" />

            <TextView
                android:id="@+id/txtGuiaInfografia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#78909C"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Infografía sugerida: diagrama de tablero"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

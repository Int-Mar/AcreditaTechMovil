<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La app habla con el servidor de Render (https) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".AcreditaTechApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AcreditaTech">

        <!-- Pantalla de Inicio / Splash -->
        <activity android:name=".controlador.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantallas de Autenticación y Flujo Inicial -->
        <activity android:name=".controlador.TermsActivity" android:exported="false" />
        <activity android:name=".controlador.LoginActivity" android:exported="false" />

        <!-- Pantallas Principales de la Barra de Navegación -->
        <activity android:name=".controlador.MenuActivity" android:exported="false" />
        <activity android:name=".controlador.TestResultActivity" android:exported="false" />
        <activity android:name=".controlador.GuidesActivity" android:exported="false" />
        <activity android:name=".controlador.DetalleGuiaActivity" android:exported="false" />
        <activity android:name=".controlador.ConstanciaActivity" android:exported="false" />
        <activity android:name=".controlador.PerfilActivity" android:exported="false" />

    </application>

</manifest>
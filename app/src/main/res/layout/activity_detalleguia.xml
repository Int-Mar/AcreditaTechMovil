<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <!-- ENCABEZADO SUPERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeTopBar"
        layout="@layout/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DATOS DE USUARIO Y TÍTULO DE LA GUÍA -->
    <LinearLayout
        android:id="@+id/layoutUserTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/includeTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="David Marlon Malagon Fuentes"
            android:textColor="?attr/appTextColor"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/txtGuideSubtype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guía Técnica"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- TARJETA BLANCA DE CONTENIDO CON SCROLL -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/appCardColor"
        app:layout_constraintTop_toBottomOf="@id/layoutUserTitle"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ENCABEZADO DEL TÍTULO DE LA GUÍA (Cambia color con Java/XML) -->
            <TextView
                android:id="@+id/txtGuideTitleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#386B90"
                android:padding="12dp"
                android:gravity="center"
                android:text="Título"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@android:color/white">

                    <!-- PRIMER BLOQUE DE TEXTO / PÁRRAFOS -->
                    <TextView
                        android:id="@+id/txtGuideParagraph1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--------------------------------------------------\n--------------------------------------------------\n--------------------------------------------------"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginBottom="16dp" />

                    <!-- CONTENEDOR DE DOS IMÁGENES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/imgGuide1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="#1B2E3C"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logoblanco"
                            android:contentDescription="Imagen 1" />

                        <ImageView
                            android:id="@+id/imgGuide2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="#1B2E3C"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logoblanco"
                            android:contentDescription="Imagen 2" />
                    </LinearLayout>

                    <!-- SEGUNDO BLOQUE DE TEXTO / PÁRRAFOS -->
                    <TextView
                        android:id="@+id/txtGuideParagraph2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--------------------------------------------------\n--------------------------------------------------\n--------------------------------------------------\n--------------------------------------------------\n--------------------------------------------------\n--------------------------------------------------"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textAlignment="center"
                        android:lineSpacingExtra="6dp" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- BARRA INFERIOR REUTILIZABLE -->
    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>